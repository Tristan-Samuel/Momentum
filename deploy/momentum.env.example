ENV=production
MOMENTUM_SECRET_KEY=
MOMENTUM_DATA_DIR=/var/lib/momentum
MOMENTUM_DB_PATH=/var/lib/momentum/momentum.db
MOMENTUM_PUBLIC_BASE_URL=https://momentum.tssamuel.com
# Comma-separated tssamuel.com emails that can see every user's data at /admin.
MOMENTUM_ADMIN_EMAILS=
MOMENTUM_APP_REDIRECTS=com.momentum.workout://auth/callback
MOMENTUM_CORS_ORIGINS=capacitor://localhost,http://localhost,http://localhost:5173
MOMENTUM_MAX_UPLOAD_MB=5
LOGIN_URL=https://login.tssamuel.com
LOGIN_TOKEN_URL=http://127.0.0.1:5111
LOGIN_CLIENT_ID=momentum
LOGIN_CLIENT_SECRET=
LOGIN_REDIRECT_URI=https://momentum.tssamuel.com/auth/sso/callback
