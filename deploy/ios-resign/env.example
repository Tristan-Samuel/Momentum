# Copied to /etc/momentum-resign.env by install.sh. Mode 600. Never commit the real file.
# Use the Apple ID that owns the Personal Team in Xcode. The account password, not an app-specific password.
# Wrap a value in double quotes if it contains spaces or #.
APPLE_ID=
APPLE_PASSWORD=
DEVICE_UDID=
IPA=/var/lib/momentum-resign/Momentum.ipa
ALTSERVER=/usr/local/lib/momentum-resign/AltServer
ANISETTE_URL=http://127.0.0.1:6969
STATE=/var/lib/momentum-resign/state.json
TWO_FA=/var/lib/momentum-resign/2fa
FORCE=/var/lib/momentum-resign/force
STATUS=/var/lib/momentum-resign/status.json
REFRESH_DAYS=5
